{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aegis SkinFees",
  "version": "0.9",
  "identifier": "io.aegisskinfees.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Aegis SkinFees · CS2 Cross-Market",
        "width": 1540,
        "height": 940,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
